# cp .env.example .env 후 값을 채우세요. .env는 커밋되지 않습니다.

# ─────────────────────────── API 키 ───────────────────────────
# 서울 열린데이터광장 — 공공자전거 실시간 대여정보
#   https://data.seoul.go.kr 에서 발급
SEOUL_OPENAPI_KEY=

# 기상청 ASOS 시간자료 — data.go.kr 발급 '일반 인증키(Decoding)'
#   공용 sample 키가 없습니다. 비워두면 호출 자체가 불가능합니다 (HTTP 403).
KMA_SERVICE_KEY=

# ──────────────────────── 수집 대상 ────────────────────────
# ASOS 관측소 지점번호. 108 = 서울.
KMA_ASOS_STATION=108

# ──────────────────────── Postgres ────────────────────────
POSTGRES_HOST_PORT=5432
POSTGRES_USER=cityops
POSTGRES_PASSWORD=cityops
POSTGRES_DB=cityops

# ──────────────────────── S3 (raw 랜딩) ────────────────────────
# 실제 AWS S3를 쓸 때는 S3_ENDPOINT를 비웁니다.
# scripts/smoke_s3.py 가 이 변수들을 그대로 읽습니다.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-northeast-2
S3_BUCKET_RAW=
