# cp .env.example .env 후 값을 채우세요. .env는 커밋되지 않습니다.

# ─────────────────────────── API 키 ───────────────────────────
# 서울 열린데이터광장 — 공공자전거 실시간 대여정보
#   https://data.seoul.go.kr 에서 발급
SEOUL_OPENAPI_KEY=

# 기상청 ASOS 시간자료 — data.go.kr 발급 '일반 인증키(Decoding)'
#   공용 sample 키가 없습니다. 비워두면 호출 자체가 불가능합니다 (HTTP 403).
KMA_SERVICE_KEY=

# ──────────────────────── 수집 대상 ────────────────────────
# ASOS 관측소 지점번호. 108 = 서울.
KMA_ASOS_STATION=108

# ──────────────────────── Postgres ────────────────────────
# libpq 표준 변수명을 씁니다 — psql(make migrate)과 dbt(dbt/profiles.yml)가
# 같은 값을 읽습니다. 이름을 두 벌 두면 한쪽만 고치는 사고가 납니다.
#
# 포트는 55432 입니다 — 5432 가 아닙니다. 로컬에 Postgres 가 이미 떠 있으면
# 컨테이너는 정상 기동하는데 접속만 기존 DB 로 가고, 증상이
# `role "cityops" does not exist` 로 나타나 포트 충돌처럼 보이지 않습니다.
# README '돌려보기' 의 `docker run -p 55432:5432` 와 같은 값이어야 합니다.
PGHOST=localhost
PGPORT=55432
PGUSER=cityops
PGPASSWORD=cityops
PGDATABASE=cityops

# make migrate 가 psql 에 넘기는 접속 문자열 (위 값과 같아야 합니다)
DATABASE_URL=postgresql://cityops:cityops@localhost:55432/cityops

# dbt 가 모델을 만들 스키마 접두. 레이어별로 _staging / _core 등이 붙습니다.
DBT_SCHEMA=dbt_dev

# ──────────────────────── S3 (raw 랜딩) ────────────────────────
# 실제 AWS S3를 쓸 때는 S3_ENDPOINT를 비웁니다.
# scripts/smoke_s3.py 가 이 변수들을 그대로 읽습니다.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-northeast-2
S3_BUCKET_RAW=
